# DocuSign Credentials
DOCUSIGN_INTEGRATION_KEY=00000000-0000-0000-0000-000000000000
DOCUSIGN_USER_ID=00000000-0000-0000-0000-000000000000
DOCUSIGN_ACCOUNT_ID=00000000-0000-0000-0000-000000000000
DOCUSIGN_PRIVATE_KEY_PATH=./private.key

# DocuSign Environment: "sandbox" or "production"
DOCUSIGN_ENVIRONMENT=sandbox

# Webhook
DOCUSIGN_WEBHOOK_HMAC_SECRET=change-me

# App
APP_BASE_URL=http://localhost:8000

# Disclosing Party / Consultant (tu empresa — fija para todos los contratos)
COMPANY_NAME=Your Company
COMPANY_ENTITY_TYPE=LLC
COMPANY_ADDRESS=123 Main St, City, State 00000
CONSULTANT_NAME=Jane Doe
CONSULTANT_TITLE=Managing Director
CONSULTANT_EMAIL=jane@example.com

# ── DocuSign Template IDs ──────────────────────────────────────────────────
DOCUSIGN_TEMPLATE_NDA=00000000-0000-0000-0000-000000000000
DOCUSIGN_TEMPLATE_MSA=00000000-0000-0000-0000-000000000000
DOCUSIGN_TEMPLATE_SOW=00000000-0000-0000-0000-000000000000

# ── Valores por defecto para contratos ────────────────────────────────────
# NDA
NDA_AGREEMENT_TERM=2 years
NDA_NON_SOLICITATION_TERM=1 year
NDA_GOVERNING_COUNTY=Miami-Dade

# MSA
MSA_PAYMENT_TERMS=15
MSA_LATE_FEE_RATE=1.5
MSA_AGREEMENT_TERM=1 year
MSA_NON_SOLICITATION_TERM=1 year
MSA_GOVERNING_COUNTY=Miami-Dade

# SOW
SOW_WARRANTY_DAYS=30
SOW_PAYMENT_TERMS=15
SOW_LATE_FEE_RATE=1.5
SOW_GOVERNING_COUNTY=Miami-Dade
